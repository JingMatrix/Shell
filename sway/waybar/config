// vim:ft=jsonc:ts=2:expandtab:sw=2
[
  {
    "height": 10, // Waybar height (to be removed for auto height)
    "output": "!DP-1",
    "ipc": true,
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": []
  },
  {
    "height": 30, // Waybar height (to be removed for auto height)
    "output": "DP-1",
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": ["sway/workspaces", "sway/mode", "custom/media"],
    "modules-center": ["sway/window"],
    "modules-right": ["custom/gsconnect", "idle_inhibitor", "bluetooth", "pulseaudio", "network", "cpu", "memory", "temperature", "custom/brightness", "clock", "custom/language", "tray"],

    // Modules configuration
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "",
        "deactivated": ""
      }
    },
    "tray": {
      "spacing": 10
    },
    "sway/window": {
      "on-click" : "swaync-client -t"
    },
    "custom/language": {
      // Not sway/language: that module cannot blank its label once it has shown
      // a value, so returning to fr(vim) (which has no xkb short name, by design)
      // left a stale "fr" on the bar. See waybar/language.sh.
      "exec": "$HOME/.config/waybar/language.sh",
      "interval": 1,
      "signal": 8,
      "on-click": "swaymsg input type:keyboard xkb_switch_layout next && pkill -RTMIN+8 waybar"
    },
    "clock": {
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format-alt": "{:%d/%m/%Y}",
      "on-click-right": "qutebrowser https://calendar.google.com/calendar/u/0/r/agenda"
    },
    "cpu": {
      "format": "{usage}% ",
      "tooltip": false,
      "on-click": "kitty --start-as=fullscreen -- htop --sort-key PERCENT_CPU -H"
    },
    "memory": {
      "format": "{}% ",
      "on-click": "kitty --start-as=fullscreen -- htop --sort-key PERCENT_MEM -H"
    },

    "temperature": {
      // This host exposes no /sys/class/thermal/thermal_zone*, so the module's
      // default source does not exist and it rendered nothing. k10temp's Tctl is
      // the CPU package sensor. The PCI path is stable across reboots, whereas
      // the hwmonN number is not, so address it via hwmon-path-abs.
      "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
      "input-filename": "temp1_input",
      "critical-threshold": 85,
      "format": "{temperatureC}°C {icon}",
      "format-icons": ["", "", ""]
    },

    "custom/brightness": {
      // Replaces the built-in backlight module: this host has no
      // /sys/class/backlight (external DisplayPort monitor), so brightness goes
      // over DDC/CI instead. See waybar/brightness.sh.
      "exec": "$HOME/.config/waybar/brightness.sh",
      "return-type": "json",
      "format": "{percentage}% {icon}",
      "format-icons": ["", "", "", "", "", "", "", "", ""],
      "interval": "once",
      "signal": 9,
      "on-scroll-up": "$HOME/.config/waybar/brightness.sh + 5",
      "on-scroll-down": "$HOME/.config/waybar/brightness.sh - 5"
    },
    "network": {
      // "interface": "wlp2*", // (Optional) To force the use of this interface
      "format-wifi": "{essid} ({signalStrength}%) ",
      "format-ethernet": "{ipaddr}/{cidr} 󰛳",
      "tooltip-format": "{ifname} via {gwaddr} 󰛳",
      "format-linked": "{ifname} (No IP) 󰛳",
      "format-disconnected": "Disconnected ⚠",
      "format-alt": "{ifname}: {ipaddr}/{cidr}",
      "on-click": "wl-copy $(hostname -I)",
      "on-click-right": "kitty --start-as=fullscreen -- nmtui",
      "on-click-middle": "$HOME/.config/waybar/vnc_sreen.sh"
    },
    "custom/gsconnect" : {
      "format": "{}",
      "escape": true,
      "exec": "python3 $HOME/.config/waybar/gsconnect-status.py",
      "return-type": "json",
      "tooltip": "{tooltip}",
      "interval": 30,
      "on-click": "gsconnect-preferences"
    },
    "bluetooth": {
      // The controller is a Qualcomm device on the WiFi 7 card (usb 0489:e10a);
      // the kernel already drives it, only bluez + bluez-utils (bluetoothd) were
      // missing. PipeWire ships the bluez5 SPA plugin with SBC/AAC/aptX/LDAC/LC3
      // out of the box, so a paired headset shows up as a sink by itself.
      // {device_battery_percentage} additionally needs "Experimental = true"
      // under [General] in /etc/bluetooth/main.conf.
      "format": "\uf00af {status}",
      "format-on": "\uf00af",
      "format-off": "\uf00b2",
      "format-disabled": "\uf00b2",
      "format-no-controller": "\uf00b2",
      "format-connected": "\uf00b1 {device_alias}",
      "format-connected-battery": "\uf00b1 {device_alias} {device_battery_percentage}%",
      "tooltip-format": "{controller_alias}\t{controller_address}",
      "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
      "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
      "on-click": "kitty --app-id launcher bluetui"
    },
    "pulseaudio": {
      // "scroll-step": 1, // %, can be a float
      "format": "{volume}% {icon} {format_source}",
      "format-bluetooth": "{volume}% {icon} {format_source}",
      "format-bluetooth-muted": "󰝟 } {format_source}",
      "format-muted": "󰝟 {format_source}",
      "format-source": "{volume}% ",
      "format-source-muted": "",
      "format-icons": {
        "headphone": "",
        "hands-free": "󰥰 ",
        "headset": "󰋎",
        "phone": "",
        "portable": "",
        "car": "",
        "default": ["", "", ""]
      },
      "on-click": "pavucontrol",
      "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
      "on-click-middle": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
  },
  "custom/media": {
    "format": "{icon} {}",
    "return-type": "json",
    "max-length": 50,
    "format-icons": {
      "spotify": " ",
      "GSConnect": "󰄡 ",
      "qutebrowser": " ",
      "default": " "
    },
    "escape": true,
    "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null", // Script in resources folder
    "on-click": "playerctl previous",
    "on-click-middle": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl volume 0.1+",
    "on-scroll-down": "playerctl volume 0.1-"
  }
  }
]

