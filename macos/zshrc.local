# Local shell setup. The installer creates this file once; customize it here.
# Set the starting directory before the instant prompt renders.
builtin cd -- "$HOME"
# Keep code that reads from the terminal above the instant-prompt block.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

SHELL_CONFIG_REPO=__SHELL_REPO__
source "$SHELL_CONFIG_REPO/macos/env.zsh"

# This machine owns its framework, plugins, and theme.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME='' # Powerlevel10k is loaded directly from Homebrew below.
zstyle ':omz:update' mode disabled
plugins=(git vi-mode pip gradle zsh-interactive-cd)
[[ ! -r $ZSH/custom/plugins/z.lua/z.lua.plugin.zsh ]] || plugins+=(z.lua)
source "$ZSH/oh-my-zsh.sh"
source "$HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme"
[[ ! -r $HOME/.p10k.zsh ]] || source "$HOME/.p10k.zsh"

# Shared aliases, functions, environment, and keybindings.
source "$SHELL_CONFIG_REPO/.zshrc"
